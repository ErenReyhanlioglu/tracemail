# Environment variables used by TraceMail.
# Copy to .env and fill in locally. Never commit .env.
#
# A variable is added here in the same change that starts using it
# (see CLAUDE.md, Configuration and Secrets). Values below are placeholders.

# --- Mailbox (IMAP, read-only) -------------------------------------------
# Gmail IMAP server and port (implicit TLS).
TRACEMAIL_IMAP_HOST=imap.gmail.com
TRACEMAIL_IMAP_PORT=993
# The application mailbox address.
TRACEMAIL_IMAP_USER=you@example.com
# A Gmail app password (16 characters), not the account password.
TRACEMAIL_IMAP_PASSWORD=xxxxxxxxxxxxxxxx
# Folder to read. Gmail localizes folder names to the account's language,
# e.g. "[Gmail]/All Mail" in English or "[Gmail]/Tüm Postalar" in Turkish.
# Use single quotes for any value with spaces, brackets, or backslashes:
# single quotes are taken literally, double quotes process escapes like \t.
TRACEMAIL_IMAP_MAILBOX='[Gmail]/All Mail'

# --- Sender exclusions ---------------------------------------------------
# Absolute path to the exclusion YAML (format: infra/config/
# sender_exclusions.example.yaml). Mail from these senders is never stored;
# everything else in the mailbox is (ADR-0025).
TRACEMAIL_SENDER_EXCLUSIONS_PATH='C:\path\to\tracemail\infra\config\sender_exclusions.yaml'

# --- Google Cloud (dev project) ------------------------------------------
TRACEMAIL_GCP_PROJECT=tracemail-510615
# Bucket holding the raw/ and parsed/ zones.
TRACEMAIL_DATA_BUCKET=tracemail-dev-data
# BigQuery: region (ADR-0011), datasets, and the per-query cost guardrail.
TRACEMAIL_BQ_LOCATION=us-central1
TRACEMAIL_BQ_LANDING_DATASET=landing
TRACEMAIL_BQ_OPS_DATASET=ops
# Read by the API: the dbt marts the web app shows.
TRACEMAIL_BQ_MARTS_DATASET=marts
# Upper bound on bytes billed by any single query (1 GiB); a query that would
# scan more fails instead of running.
TRACEMAIL_BQ_MAX_BYTES_BILLED=1073741824
# Days a run record is kept in ops.pipeline_runs before its partition expires.
TRACEMAIL_OPS_RETENTION_DAYS=400
# Local development authenticates with `gcloud auth application-default login`
# and needs nothing here. To use a service account key file instead, point to
# it below; the file must live outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repo\ingestion-key.json

# --- Airflow (Compose stack, ADR-0013) ------------------------------------
# Generate each secret once, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The Fernet key must be 32 url-safe base64 bytes:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TRACEMAIL_AIRFLOW_DB_PASSWORD=change-me
TRACEMAIL_AIRFLOW_JWT_SECRET=change-me
TRACEMAIL_AIRFLOW_FERNET_KEY=change-me
# Credentials files mounted read-only into the containers, one per role
# (ADR-0009). Locally all three point at the gcloud application-default
# credentials file; on the VM at the role key files in
# /opt/tracemail/secrets (infra/gcp/README.md).
#   pipeline tasks (ingestion key):
TRACEMAIL_GCP_CREDENTIALS_FILE='C:\Users\you\AppData\Roaming\gcloud\application_default_credentials.json'
#   dbt's prod target (transform key; the dev target ignores it):
TRACEMAIL_DBT_CREDENTIALS_FILE='C:\Users\you\AppData\Roaming\gcloud\application_default_credentials.json'
#   API (api key):
TRACEMAIL_API_CREDENTIALS_FILE='C:\Users\you\AppData\Roaming\gcloud\application_default_credentials.json'
# dbt profile target: dev locally (gcloud login), prod on the VM (transform key).
TRACEMAIL_DBT_TARGET=dev

# --- Images (ADR-0012) -------------------------------------------------------
# Locally the images are built and tagged with these. On the VM the registry
# is ghcr.io/<lowercase GitHub owner> and the tag is left out here: the
# deploy script writes the commit SHA to /opt/tracemail/release.env, which
# overrides this file (infra/vm/README.md).
TRACEMAIL_IMAGE_REGISTRY=tracemail
TRACEMAIL_IMAGE_TAG=local

# --- Cloudflare Tunnel (VM only, `tunnel` profile, ADR-0016) -----------------
# File holding the tunnel token (Cloudflare Zero Trust -> Networks ->
# Tunnels). Compose requires a value even where the tunnel does not run; any
# existing file path works locally.
TRACEMAIL_TUNNEL_TOKEN_FILE='C:\Users\you\AppData\Roaming\gcloud\application_default_credentials.json'

# --- API: owner login (ADR-0015, ADR-0032) --------------------------------
# OAuth client of the dev project (Google Auth Platform -> Clients). The
# secret is shown only once when the client is created.
TRACEMAIL_API_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
TRACEMAIL_API_GOOGLE_CLIENT_SECRET=change-me
# Google's stable account id ("sub") of the one account allowed to log in.
# Not the email address. To find it, start with any placeholder, sign in;
# the refusal page shows the signed-in account its own id.
TRACEMAIL_API_OWNER_SUB=0
# Signs the session cookie. Rotating it logs out every session.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRACEMAIL_API_SESSION_SECRET=change-me
# Public base URL: the address the browser opens. Locally that is the web
# app (`just web`, port 3000), which forwards /api to the API. The OAuth
# redirect URI is this plus /api/v1/auth/google/callback and must be
# registered on the OAuth client:
#   http://localhost:3000/api/v1/auth/google/callback
TRACEMAIL_API_PUBLIC_URL=http://localhost:3000

# --- Web app (ADR-0034) ----------------------------------------------------
# Where the Next.js server reaches the API (`just api`, port 8000): its
# server-side data requests and the /api forwarding. The browser never uses
# this address.
TRACEMAIL_API_URL=http://localhost:8000
